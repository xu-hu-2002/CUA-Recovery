+async def _with_retries(fn, *, what: str) -> tuple[bool, str]:
+    """Run an LLM call with exponential backoff. Never converts an error
+    into a rubric verdict — exhausted retries raise JudgeCallError."""
+    try:
+        attempts = int(os.environ.get("MYPCBENCH_OSWORLD_JUDGE_MAX_RETRIES")
+                       or DEFAULT_MAX_RETRIES)
+    except ValueError:
+        attempts = DEFAULT_MAX_RETRIES
+    attempts = max(1, attempts)
+
+    last: Exception | None = None
+    tried = 0
+    for attempt in range(attempts):
+        tried = attempt + 1
+        try:
+            return await fn()
+        except JudgeCallError as exc:
+            last = exc
+            if attempt == attempts - 1:
+                break
+            delay = 2.0 * (2**attempt)
+            print(f"warning: {what}: {exc}; retry {attempt + 1}/{attempts - 1} "
+                  f"in {delay:.0f}s", file=sys.stderr)
+            await asyncio.sleep(delay)
+        except Exception as exc:
+            last = exc
+            if not _is_transient(exc) or attempt == attempts - 1:
+                break
+            delay = 2.0 * (2**attempt)
+            print(f"warning: {what}: {type(exc).__name__}: {exc}; retry "
+                  f"{attempt + 1}/{attempts - 1} in {delay:.0f}s", file=sys.stderr)
+            await asyncio.sleep(delay)
+    raise JudgeCallError(f"{what} failed after {tried} attempt(s): "
