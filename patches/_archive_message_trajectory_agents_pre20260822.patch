+def _trajectory_agent_metadata(agent):
+    """Snapshot adapter metadata plus the current turn's public tool transcript."""
+
+    raw_metadata = getattr(agent, "agent_metadata", None)
+    if isinstance(raw_metadata, dict):
+        metadata = copy.deepcopy(raw_metadata)
+    elif raw_metadata is None:
+        metadata = {}
+    else:
+        metadata = {"adapter_metadata": copy.deepcopy(raw_metadata)}
+
+    tool_messages = getattr(agent, "last_trajectory_tool_messages", None)
+    if tool_messages:
+        metadata["tool_messages"] = copy.deepcopy(tool_messages)
+    return metadata or None
+
+
