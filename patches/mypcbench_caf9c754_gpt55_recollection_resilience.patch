+    def _recover_screenshot(self, screenshot: Any) -> Any:
+        """Return a real screenshot or fail before sending an unmatched call."""
+        if screenshot or not self._last_computer_call_id:
+            return screenshot
+        for attempt in range(self._screenshot_retry_limit):
+            try:
+                recovered = (self.env._get_obs() or {}).get("screenshot")
+            except Exception as exc:
+                logger.warning("Screenshot retry %d failed: %s", attempt + 1, exc)
+                recovered = None
+            if recovered:
+                return recovered
+            time.sleep(min(2.0, 0.5 * (attempt + 1)))
+        raise ScreenshotUnavailableError(
+            f"no screenshot for computer call {self._last_computer_call_id} "
+            f"after {self._screenshot_retry_limit} retries"
+        )
