 # ---------------------------------------------------------------------------
 
 
+# RECOVERY transient-retry (2026-08-15): recovered from the lost
+# patches/mypcbench_caf9c754_recovery_judge.patch (_with_retries/_is_transient).
+# Without retries a single 429 / connection / timeout blip fails the rubric
+# and — before the fail-loud guard below — was silently scored 0.
+_TRANSIENT_HINTS = (
+    "429", "rate limit", "rate_limit", "timeout", "timed out", "temporarily",
+    "overloaded", "connection", "529", "503", "502", "500",
+)
+
+
+def _is_transient_error(exc: Exception) -> bool:
+    status = getattr(exc, "status_code", None)
+    if isinstance(status, int):
+        if status == 429 or status >= 500:
+            return True
+        if 400 <= status < 500:
+            return False
+    name = type(exc).__name__.lower()
+    if any(k in name for k in ("ratelimit", "timeout", "connection", "apierror")):
+        return True
+    return any(h in str(exc).lower() for h in _TRANSIENT_HINTS)
+
+
+def _retry_delay(exc: Exception, attempt: int) -> float:
+    response = getattr(exc, "response", None)
+    headers = getattr(response, "headers", {}) or {}
+    retry_after = headers.get("retry-after") or headers.get("Retry-After")
+    try:
+        advertised = float(retry_after)
+    except (TypeError, ValueError):
+        advertised = 0.0
+    base = advertised if advertised > 0 else 2.0 * (2 ** attempt)
+    return min(60.0, base * random.uniform(0.8, 1.2))
+
+
+async def _with_retries(fn, *, what: str, attempts: int = 4):
+    last: Exception | None = None
+    for i in range(attempts):
+        try:
+            return await fn()
+        except Exception as exc:
+            last = exc
+            if not _is_transient_error(exc) or i == attempts - 1:
+                raise
+            wait = _retry_delay(exc, i)
+            print(
+                f"warning: {what} transient failure ({exc}); "
+                f"retry {i + 1}/{attempts - 1} in {wait:.0f}s",
+                file=sys.stderr,
+            )
+            await asyncio.sleep(wait)
+    raise last  # pragma: no cover
+
+
