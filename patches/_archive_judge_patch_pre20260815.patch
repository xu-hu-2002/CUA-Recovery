+def _maybe_recompress(data: bytes, mime: str) -> tuple[bytes, str]:
+    """Optionally re-encode a screenshot to JPEG to shrink the request body.
+
+    Only the transport shrinks: billed image tokens are a function of pixel
+    dimensions (32px patches / 512px tiles), which this does not touch. Any
+    failure returns the original bytes — a grading run must not die because
+    Pillow is missing.
+    """
+    fmt = (os.environ.get("MYPCBENCH_OSWORLD_JUDGE_IMAGE_FORMAT") or "").strip().lower()
+    if fmt not in {"jpeg", "jpg"}:
+        return data, mime
+    try:
+        quality = int(os.environ.get("MYPCBENCH_OSWORLD_JUDGE_IMAGE_QUALITY", "85") or 85)
+    except ValueError:
+        quality = 85
+    try:
+        import io
+
+        from PIL import Image  # type: ignore
+
+        with Image.open(io.BytesIO(data)) as im:
+            rgb = im.convert("RGB")
+            buf = io.BytesIO()
+            rgb.save(buf, format="JPEG", quality=quality, optimize=True)
+        return buf.getvalue(), "image/jpeg"
+    except Exception as exc:  # pragma: no cover - transport optimisation only
+        print(f"warning: JPEG re-encode failed ({exc}); sending original bytes",
+              file=sys.stderr)
+        return data, mime
+
+
