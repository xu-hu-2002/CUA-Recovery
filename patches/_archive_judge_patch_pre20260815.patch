+def _resolve_model_and_provider() -> tuple[str, str]:
+    """Pick (model, provider), tolerating an OpenAI-only environment.
+
+    The old behaviour was to default to the Gemini paper model and then die
+    in _make_gemini_client() on a missing GEMINI_API_KEY, even when
+    OPENAI_API_KEY was right there. Only auto-switch when the model was NOT
+    pinned — an explicit model is a deliberate choice and must not be
+    silently replaced.
+    """
+    pinned = (os.environ.get("MYPCBENCH_RUBRIC_JUDGE_MODEL") or "").strip()
+    if pinned:
+        return pinned, _resolve_provider(pinned)
+
+    forced = (os.environ.get("MYPCBENCH_JUDGE_PROVIDER") or "").strip().lower()
+    has_gemini_key = bool(
+        (os.environ.get("GEMINI_API_KEY") or os.environ.get("GOOGLE_API_KEY") or "").strip()
+    )
+    has_openai_key = bool((os.environ.get("OPENAI_API_KEY") or "").strip())
