+def _encode_jpeg(data: bytes, quality: int) -> bytes | None:
+    try:
+        import io
+
+        from PIL import Image  # type: ignore
+
+        with Image.open(io.BytesIO(data)) as im:
+            buf = io.BytesIO()
+            im.convert("RGB").save(buf, format="JPEG", quality=quality, optimize=True)
+        return buf.getvalue()
+    except Exception:
+        return None
+
+
+def _fit_image_budget(
+    assets: list[dict[str, Any]],
+) -> tuple[list[dict[str, Any]], str | None]:
+    """Shrink a trajectory's screenshots until the request is accepted.
+
+    OpenAI rejects a request whose *total image size* exceeds 50MB with a 400,
+    counted on the decoded bytes (not the base64 expansion). 6 of the 184 v1
+    trajectories blow through it — 108MB in the worst case. Without this they
+    score judge_error, which the canonical average counts as 0.0: a long
+    trajectory would be punished for being long.
+
+    Degrade in the order that costs the least evidence: JPEG at high quality,
+    then lower quality, and only then drop the OLDEST screenshots (the tail of
+    a trajectory is what a rubric is usually decided on).
+    """
+    try:
+        limit_mb = float(os.environ.get("MYPCBENCH_OSWORLD_JUDGE_MAX_IMAGE_MB")
+                         or DEFAULT_MAX_IMAGE_MB)
+    except ValueError:
+        limit_mb = DEFAULT_MAX_IMAGE_MB
+    if limit_mb <= 0 or not assets:
+        return assets, None
+
+    limit = limit_mb * 1e6
+    total = sum(len(a["bytes"]) for a in assets)
+    if total <= limit:
+        return assets, None
+
+    original_mb = total / 1e6
+    for quality in (85, 70, 55):
+        shrunk = []
+        for a in assets:
+            data = _encode_jpeg(a["bytes"], quality)
+            if data is None:
+                return assets, (
+                    f"{original_mb:.0f}MB exceeds the {limit_mb:.0f}MB image budget "
+                    "and Pillow is unavailable to re-encode"
+                )
+            shrunk.append({**a, "bytes": data, "mime": "image/jpeg",
+                           "data_url": "data:image/jpeg;base64,"
+                                       + base64.b64encode(data).decode("ascii")})
+        total = sum(len(a["bytes"]) for a in shrunk)
+        if total <= limit:
+            return shrunk, (f"re-encoded {len(shrunk)} screenshots to JPEG q{quality}: "
+                            f"{original_mb:.0f}MB -> {total / 1e6:.0f}MB")
+        assets = shrunk
+
+    dropped = 0
+    while assets and sum(len(a["bytes"]) for a in assets) > limit:
+        assets.pop(0)
+        dropped += 1
+    return assets, (f"re-encoded to JPEG q55 and dropped the {dropped} oldest "
+                    f"screenshots to fit {limit_mb:.0f}MB (from {original_mb:.0f}MB)")
