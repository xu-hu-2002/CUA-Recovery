+def _is_transient(exc: Exception) -> bool:
+    """Rate limits, timeouts and 5xx are worth retrying; 4xx is not."""
+    status = getattr(exc, "status_code", None) or getattr(exc, "code", None)
+    if isinstance(status, int):
+        return status == 408 or status == 429 or status >= 500
+    name = type(exc).__name__.lower()
+    if any(k in name for k in ("ratelimit", "timeout", "connection", "apierror",
+                               "internalserver", "serviceunavailable", "overloaded")):
+        return True
+    blob = str(exc).lower()
+    return any(k in blob for k in ("429", "rate limit", "timeout", "temporarily",
+                                   "overloaded", "503", "502", "500"))
+
