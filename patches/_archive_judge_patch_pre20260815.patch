+def _resolve_provider(model: str) -> str:
+    """Return 'gemini' or 'openai' for `model`.
+
+    Name-sniffing alone is wrong for OpenAI-compatible endpoints: a vLLM or
+    proxy deployment can serve any model name, so an explicit
+    MYPCBENCH_JUDGE_PROVIDER always wins. Unknown names fall through to the
+    OpenAI-compatible path (that is where OPENAI_BASE_URL lives).
+    """
+    explicit = (os.environ.get("MYPCBENCH_JUDGE_PROVIDER") or "").strip().lower()
+    if explicit:
+        if explicit in {"gemini", "google", "google-genai"}:
+            return "gemini"
+        if explicit in {"openai", "oai", "openai-compatible", "openai_compatible"}:
+            return "openai"
+        raise SystemExit(
+            f"unknown MYPCBENCH_JUDGE_PROVIDER={explicit!r}; use 'gemini' or 'openai'"
+        )
+    if _is_gemini_model(model):
+        return "gemini"
+    return "openai"
+
