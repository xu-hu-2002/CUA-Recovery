+import logging
+import os
+import random
+import re
+import time
+from typing import Dict, List, Optional, Tuple
+
+_rate_logger = logging.getLogger("mypcbench.agent.ratelimit")
+
+# RECOVERY: gateway rate-limit handling.
+#
+# The API gateway caps requests per API KEY (60 RPM measured 2026-08-06),
+# shared across every model behind that key. A single agent loop only averages
+# ~5 RPM, but consecutive fast steps burst far above that, and running several
+# collection shards concurrently multiplies the burst. The upstream retry
+# budget (5 attempts, <=5s apart) is far too small for that: it burns through
+# in ~20s and the step is recorded as a model failure, silently polluting the
+# collection with fake "no action returned" steps.
+#
+# Rate limits are an infrastructure condition, not model behaviour, so they get
+# their own budget with exponential backoff. Jitter is mandatory: without it,
+# shards that hit the limit together stay in lockstep and keep colliding.
+_RATE_LIMIT_MARKERS = (
+    "rate limit",
+    "rate_limit",
+    "ratelimit",
+    "too many requests",
+    "429",
+    "RPM",
+)
+
+
+def is_rate_limit_error(exc: BaseException) -> bool:
+    """True when an exception looks like a gateway/provider rate limit."""
+    status = getattr(exc, "status_code", None) or getattr(exc, "status", None)
+    if status == 429:
+        return True
+    resp = getattr(exc, "response", None)
+    if resp is not None and getattr(resp, "status_code", None) == 429:
+        return True
+    if type(exc).__name__ in ("RateLimitError", "APIRateLimitError"):
+        return True
+    text = str(exc)
+    return any(m.lower() in text.lower() for m in _RATE_LIMIT_MARKERS)
+
+
+def retry_after_seconds(exc: BaseException) -> Optional[float]:
+    """Extract a server-advertised Retry-After (seconds) if present."""
+    resp = getattr(exc, "response", None)
+    headers = getattr(resp, "headers", None)
+    if headers:
+        for key in ("retry-after", "Retry-After", "x-ratelimit-reset-requests"):
+            raw = None
+            try:
+                raw = headers.get(key)
+            except Exception:
+                pass
+            if raw:
+                try:
+                    return max(0.0, float(str(raw).rstrip("s")))
+                except (TypeError, ValueError):
+                    continue
+    match = re.search(r"retry[- ]after[^0-9]{0,10}(\d+(?:\.\d+)?)", str(exc), re.I)
+    if match:
+        return float(match.group(1))
+    return None
+
+
+def rate_limit_sleep(
+    exc: BaseException,
+    attempt: int,
+    *,
+    base: float = 5.0,
+    cap: float = 120.0,
+    label: str = "api",
+) -> float:
+    """Sleep for a rate-limited retry; returns the seconds actually waited.
+
+    `attempt` is 1-based. Honours Retry-After when the server sends it,
+    otherwise exponential backoff with +-40% jitter, capped at `cap`.
+    """
+    advertised = retry_after_seconds(exc)
+    if advertised is not None:
+        delay = min(cap, advertised + random.uniform(0.0, 2.0))
+    else:
+        delay = min(cap, base * (2 ** max(0, attempt - 1)))
+        delay *= random.uniform(0.6, 1.4)
+    _rate_logger.warning(
+        "%s rate limited (attempt %d); backing off %.1fs%s",
+        label, attempt, delay,
+        " (server Retry-After)" if advertised is not None else "",
+    )
+    time.sleep(delay)
+    return delay
+
+
+def rate_limit_retry_budget(env_name: str, default: int = 8) -> int:
+    """Read a rate-limit retry budget from the environment (>=1)."""
+    try:
+        return max(1, int(os.environ.get(env_name, default)))
+    except (TypeError, ValueError):
+        return default
 
 
