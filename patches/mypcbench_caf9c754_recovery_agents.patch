+# RECOVERY: placeholder image for pruned-out history screenshots in ZDR
+# stateless mode (see _OpenAICUABase docstring additions). A minimal valid
+# 8x8 grey PNG, built deterministically at import so no asset file is needed.
+def _build_placeholder_png() -> str:
+    import base64 as _b64
+    import struct as _struct
+    import zlib as _zlib
+
+    def _chunk(tag: bytes, data: bytes) -> bytes:
+        c = _struct.pack(">I", len(data)) + tag + data
+        return c + _struct.pack(">I", _zlib.crc32(tag + data) & 0xFFFFFFFF)
+
+    ihdr = _struct.pack(">IIBBBBB", 8, 8, 8, 0, 0, 0, 0)  # 8x8 grayscale
+    raw = b"".join(b"\x00" + b"\x80" * 8 for _ in range(8))
+    png = (
+        b"\x89PNG\r\n\x1a\n"
+        + _chunk(b"IHDR", ihdr)
+        + _chunk(b"IDAT", _zlib.compress(raw))
+        + _chunk(b"IEND", b"")
+    )
+    return _b64.b64encode(png).decode()
+
+
+_PLACEHOLDER_IMAGE_URL = f"data:image/png;base64,{_build_placeholder_png()}"
+
 
