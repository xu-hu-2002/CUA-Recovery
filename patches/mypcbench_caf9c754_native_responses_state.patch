+def _persist_native_responses_state(agent, result_dir: str) -> None:
+    """Checkpoint lossless ZDR Responses state after a completed API turn."""
+
+    native_state = getattr(agent, "native_responses_state", None)
+    if not native_state or not native_state.get("zdr_stateless"):
+        return
+    _fsync_write(
+        os.path.join(result_dir, "native_responses_state.json"),
+        json.dumps(native_state, ensure_ascii=False, indent=2),
+        mode="w",
+    )
