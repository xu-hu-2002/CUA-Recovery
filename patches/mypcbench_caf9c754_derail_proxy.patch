--- a/agent-harness/env.py
+++ b/agent-harness/env.py
@@ -457 +457,4 @@ class MyPCBenchEnv:
-            if self.vm_ip != "localhost" and self.vm_ip != "127.0.0.1":
+            if (
+                self.vm_ip != "localhost" and self.vm_ip != "127.0.0.1"
+                or os.environ.get("MYPCBENCH_REMOTE_ATTACH") == "1"
+            ):
@@ -636,0 +640,22 @@ class MyPCBenchEnv:
+    def _remote_lifecycle(self, mode: str) -> None:
+        """POST reset operations to the Nebula-side ROCK lifecycle server."""
+
+        port = int(os.environ.get("MYPCBENCH_LIFECYCLE_PORT", "19090"))
+        url = f"http://127.0.0.1:{port}/{mode}"
+        for attempt in range(3):
+            try:
+                response = self._session.post(url, timeout=1800)
+                response.raise_for_status()
+                log.info("Remote lifecycle %s OK: %s", mode, str(response.text)[:200])
+                return
+            except Exception as error:
+                log.warning(
+                    "Remote lifecycle %s attempt %d/3 failed: %s",
+                    mode,
+                    attempt + 1,
+                    error,
+                )
+                if attempt == 2:
+                    raise
+                time.sleep(10)
+
@@ -645,0 +671,4 @@ class MyPCBenchEnv:
+        if os.environ.get("MYPCBENCH_REMOTE_ATTACH") == "1":
+            self._remote_lifecycle("reset")
+            self._wait_for_ready()
+            return
