diff --git a/agent-harness/utils/osworld_full_traj_judge.py b/agent-harness/utils/osworld_full_traj_judge.py
--- a/agent-harness/utils/osworld_full_traj_judge.py
+++ b/agent-harness/utils/osworld_full_traj_judge.py
@@ -62,0 +63 @@ import sys
+import threading
@@ -73,0 +75 @@ DEFAULT_REQUEST_TIMEOUT_SECONDS = 300.0
+DEFAULT_PROCESS_TIMEOUT_SECONDS = 900.0
@@ -288,0 +291,8 @@ def _request_timeout_seconds() -> float:
+def _process_timeout_seconds() -> float:
+    raw = os.environ.get("MYPCBENCH_OSWORLD_JUDGE_PROCESS_TIMEOUT", "").strip()
+    timeout = float(raw) if raw else DEFAULT_PROCESS_TIMEOUT_SECONDS
+    if timeout <= 0:
+        raise ValueError("judge process timeout must be positive")
+    return timeout
+
+
@@ -651 +661,8 @@ def main() -> None:
