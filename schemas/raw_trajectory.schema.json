{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DERAIL Raw Agent Trajectory",
  "$comment": "保留 provider 原始消息和 artifact hash；任何 normalization 都不得覆盖 raw record。",
  "type": "object",
  "properties": {
    "rollout_id": {"type": "string", "minLength": 1},
    "source_benchmark": {"const": "mypcbench"},
    "task_id": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "minLength": 1},
    "model_revision": {"type": "string", "minLength": 1},
    "snapshot_sha256": {"type": "string", "minLength": 1},
    "prompt_sha256": {"type": "string", "minLength": 1},
    "messages": {"type": "array", "items": {"type": "object"}},
    "task_success": {"type": "boolean"},
    "artifact_manifest_uri": {"type": "string", "minLength": 1}
  },
  "required": [
    "rollout_id",
    "source_benchmark",
    "task_id",
    "agent_id",
    "model_revision",
    "snapshot_sha256",
    "prompt_sha256",
    "messages",
    "task_success",
    "artifact_manifest_uri"
  ],
  "additionalProperties": false
}
