{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://derail.local/schemas/compatibility_edge.schema.json",
  "title": "DERAIL pairwise grounded-module compatibility edge",
  "type": "object",
  "required": [
    "schema_version", "edge_id", "from_module", "to_module", "bindings",
    "environment_status", "environment_scope", "conflicts",
    "rejected_binding_checks", "compatibility_score", "check_results"
  ],
  "properties": {
    "schema_version": {"const": "compat-edge/0.1"},
    "edge_id": {"type": "string", "minLength": 1},
    "from_module": {"type": "string", "minLength": 1},
    "to_module": {"type": "string", "minLength": 1},
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "binding_id", "output_node_id", "output_port", "input_node_id",
          "input_port", "produced_type", "accepted_type", "unified_type",
          "output_grounding", "input_grounding", "output_cardinality",
          "input_cardinality", "converter_id", "dependency_kind",
          "source_op", "target_op", "score"
        ],
        "properties": {
          "binding_id": {"type": "string", "minLength": 1},
          "output_node_id": {"type": "string", "minLength": 1},
          "output_port": {"type": "string", "minLength": 1},
          "input_node_id": {"type": "string", "minLength": 1},
          "input_port": {"type": "string", "minLength": 1},
          "produced_type": {"type": "string", "minLength": 1},
          "accepted_type": {"type": "string", "minLength": 1},
          "unified_type": {"type": "string", "minLength": 1},
          "output_grounding": {"type": "string", "minLength": 1},
          "input_grounding": {"type": "string", "minLength": 1},
          "output_cardinality": {"enum": ["one", "optional", "many"]},
          "input_cardinality": {"enum": ["one", "optional", "many"]},
          "converter_id": {"type": ["string", "null"]},
          "dependency_kind": {
            "enum": ["data_dependency", "state_dependency", "control_dependency"]
          },
          "source_op": {"type": "string", "minLength": 1},
          "target_op": {"type": "string", "minLength": 1},
          "score": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": true
      }
    },
    "environment_status": {"enum": ["direct", "materializable", "schema_only", "incompatible"]},
    "environment_scope": {"type": "object"},
    "conflicts": {"type": "array", "items": {"type": "string"}},
    "rejected_binding_checks": {"type": "array", "items": {"type": "string"}},
    "compatibility_score": {"type": "number", "minimum": 0, "maximum": 1},
    "check_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "passed"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
