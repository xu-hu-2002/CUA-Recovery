{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://derail-benchmark.org/schemas/replay_plan.schema.json",
  "title": "DERAIL Replay Plan v0.2",
  "type": "object",
  "properties": {
    "attempt_id": {"type": "string", "minLength": 1},
    "build_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "instance": {"$ref": "depth_instance.schema.json"},
    "snapshot_uri": {"type": "string", "minLength": 1},
    "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_trajectory_uri": {"type": "string", "minLength": 1},
    "canonical_trajectory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected_state_sha256": {"type": "string"}
    ,"task_id": {"type": "string", "minLength": 1}
    ,"instruction_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    ,"task_config_uri": {"type": "string", "minLength": 1}
    ,"task_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    ,"state_probe_config_uri": {"type": "string", "minLength": 1}
    ,"state_probe_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "required": [
    "attempt_id", "build_id", "case_id", "instance", "snapshot_uri",
    "snapshot_sha256", "canonical_trajectory_uri", "canonical_trajectory_sha256",
    "expected_state_sha256", "task_id", "instruction_sha256", "task_config_uri",
    "task_config_sha256", "state_probe_config_uri", "state_probe_config_sha256"
  ],
  "additionalProperties": false
}
