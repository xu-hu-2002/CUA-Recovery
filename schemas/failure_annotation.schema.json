{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recovery.local/schemas/failure_annotation.schema.json",
  "title": "RECOVERY enriched failure annotation (failure-annotation/0.1)",
  "$comment": "Human root-cause labels enriched with paper_type/group and the deterministic post-error continuation statistics (manual v0.2 section 14A.1). group is derived from paper_type, never annotated. Horizon fields stay null when not annotated.",
  "type": "object",
  "required": [
    "schema_version", "annotation_version", "task_id", "model_id", "rollout_id",
    "root_cause_action_index", "paper_type", "paper_category", "group", "error_types",
    "reversibility_stratum", "post_error_steps", "loop_detected", "terminated_explicitly",
    "milestone_hint_used", "root_cause_in_lineage_hint", "review_status"
  ],
  "properties": {
    "schema_version": {"const": "failure-annotation/0.1"},
    "annotation_version": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "rollout_id": {"type": "string", "minLength": 1},
    "root_cause_action_index": {"type": "integer", "minimum": 0},
    "root_cause_milestone_id": {"type": ["string", "null"]},
    "paper_type": {"type": "string", "minLength": 1},
    "paper_category": {"enum": ["planning", "perception", "execution", "termination"]},
    "group": {"enum": ["local", "long_horizon", "termination"]},
    "error_types": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "secondary_causes": {"type": "array", "items": {"type": "string"}},
    "multi_root_cause": {"type": "boolean"},
    "reversibility_stratum": {"enum": ["reversible", "irreversible"]},
    "root_cause_reversibility_class": {"type": ["string", "null"]},
    "downstream_commit_class": {"type": ["string", "null"]},
    "earliest_identifiable_action_index": {"type": ["integer", "null"], "minimum": 0},
    "earliest_identifiable_milestone_id": {"type": ["string", "null"]},
    "action_horizon": {"type": ["integer", "null"], "minimum": 0},
    "semantic_horizon": {"type": ["integer", "null"], "minimum": 0},
    "horizon_censored": {"type": "boolean"},
    "post_error_steps": {"type": "integer", "minimum": 0},
    "loop_detected": {"type": "boolean"},
    "loop_established_offset": {"type": ["integer", "null"], "minimum": 1},
    "terminated_explicitly": {"type": "boolean"},
    "loop_heuristic_version": {"type": "string"},
    "milestone_hint_used": {"type": "boolean"},
    "root_cause_in_lineage_hint": {"type": ["boolean", "null"]},
    "review_status": {"enum": ["single_annotator", "double_annotated", "adjudicated"]},
    "provenance": {"type": "object"}
  },
  "additionalProperties": false
}
