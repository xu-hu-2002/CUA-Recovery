{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://derail-benchmark.org/schemas/benchmark_case.schema.json",
  "title": "DERAIL Derived Case Plan v0.2",
  "$comment": "A case stays release_eligible=false until every depth has accepted real-VM replay and compatibility evidence.",
  "type": "object",
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "build_id": {"type": "string", "minLength": 1},
    "collection_id": {"type": "string", "minLength": 1},
    "trajectory_id": {"type": "string", "minLength": 1},
    "source_trajectory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_raw_uri": {"type": "string", "minLength": 1},
    "adjudication_id": {"type": "string", "minLength": 1},
    "root_cause_action_index": {"type": "integer", "minimum": 0},
    "error_horizon_actions": {"type": ["integer", "null"], "minimum": 0},
    "identifiable_at_action_index": {"type": ["integer", "null"], "minimum": 0},
    "error_types": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "reversibility": {"enum": ["reversible", "irreversible"]},
    "taxonomy_version": {"type": "string", "minLength": 1},
    "taxonomy_status": {"enum": ["open_coding", "frozen_membership_validated"]},
    "error_types_outside_seed": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "available_depths": {"type": "array", "items": {"enum": [0, 5, 10, 15, 20, 25]}, "minItems": 1, "uniqueItems": true},
    "unavailable_depth_reasons": {"type": "object", "additionalProperties": {"type": "string"}},
    "canonical_original_uri": {"type": "string", "minLength": 1},
    "canonical_original_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_repaired_uri": {"type": "string", "minLength": 1},
    "canonical_repaired_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_repaired_actions_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "human_annotation_refs": {"type": "array", "items": {"type": "object"}, "minItems": 2},
    "adjudication_ref": {"type": "object"},
    "rubric_review_refs": {"type": "array", "items": {"type": "object"}, "minItems": 2},
    "rubric_review_adjudication_ref": {"type": "object"},
    "human_rubric_score": {
      "type": "object",
      "properties": {
        "weighted_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "score": {"type": "integer", "minimum": 0, "maximum": 100},
        "perfect": {"type": "boolean"},
        "passed_rubric_count": {"type": "integer", "minimum": 0},
        "rubric_count": {"type": "integer", "minimum": 1}
      },
      "required": ["weighted_fraction", "score", "perfect", "passed_rubric_count", "rubric_count"],
      "additionalProperties": false
    },
    "rubric_review_disagreement_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "judge_rubric_disagreement_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "repair_patch_ref": {"type": "object"},
    "prefix_audit_ref": {"type": "object"},
    "source_collection_manifest_ref": {"type": "object"},
    "task_id": {"type": "string", "minLength": 1},
    "instruction": {"type": "string", "minLength": 1},
    "instruction_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pre_command_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_config_ref": {"type": "object"},
    "rubric_bundle_ref": {"type": "object"},
    "state_probe_config_ref": {"type": "object"},
    "taxonomy_ref": {"type": "object"},
    "required_compatible_agents": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "agent_compatibility_status": {"enum": ["pending_conformance_evidence", "verified", "rejected"]},
    "prefix_state_status": {"enum": ["pending_real_vm_replay", "verified", "rejected"]},
    "release_eligible": {"type": "boolean"},
    "instances": {"type": "array", "items": {"$ref": "depth_instance.schema.json"}, "minItems": 1}
  },
  "required": [
    "case_id", "build_id", "collection_id", "trajectory_id", "source_trajectory_sha256",
    "source_raw_uri", "adjudication_id", "root_cause_action_index", "error_horizon_actions",
    "identifiable_at_action_index", "error_types", "reversibility", "taxonomy_version",
    "taxonomy_status", "error_types_outside_seed", "available_depths",
    "unavailable_depth_reasons", "canonical_original_uri", "canonical_original_sha256",
    "canonical_repaired_uri", "canonical_repaired_sha256", "canonical_repaired_actions_sha256",
    "human_annotation_refs", "adjudication_ref", "rubric_review_refs",
    "rubric_review_adjudication_ref", "human_rubric_score",
    "rubric_review_disagreement_ids", "judge_rubric_disagreement_ids",
    "repair_patch_ref", "prefix_audit_ref",
    "source_collection_manifest_ref", "required_compatible_agents",
    "task_id", "instruction", "instruction_sha256", "pre_command_sha256",
    "task_config_ref", "rubric_bundle_ref", "state_probe_config_ref", "taxonomy_ref",
    "agent_compatibility_status", "prefix_state_status", "release_eligible", "instances"
  ],
  "additionalProperties": false
}
