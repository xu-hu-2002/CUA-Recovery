{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recovery.local/schemas/synthesis_config.schema.json",
  "title": "RECOVERY long-horizon synthesis configuration",
  "type": "object",
  "required": [
    "schema_version",
    "generation_version",
    "target_count",
    "target_environment",
    "target_snapshot",
    "source_split",
    "sampling_mode",
    "seed",
    "max_attempts",
    "beam_width",
    "min_modules",
    "max_modules",
    "dependency_depth",
    "cross_app_dependencies",
    "max_independent_component_ratio",
    "required_delayed_reuse",
    "max_irreversible_actions",
    "min_verifier_coverage"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "synthesis-config/0.1",
        "synthesis-config/0.2"
      ]
    },
    "generation_version": {
      "type": "string",
      "minLength": 1
    },
    "target_count": {
      "type": "integer",
      "minimum": 1
    },
    "target_environment": {
      "type": "string",
      "minLength": 1
    },
    "target_snapshot": {
      "type": "string",
      "minLength": 1
    },
    "source_split": {
      "enum": [
        "source-development",
        "source-pilot",
        "source-holdout"
      ]
    },
    "sampling_mode": {
      "enum": [
        "empirical_only",
        "failure_informed_bounded"
      ]
    },
    "seed": {
      "type": "integer"
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1
    },
    "beam_width": {
      "type": "integer",
      "minimum": 1
    },
    "min_modules": {
      "type": "integer",
      "minimum": 2
    },
    "max_modules": {
      "type": "integer",
      "minimum": 2
    },
    "dependency_depth": {
      "$ref": "#/$defs/range"
    },
    "cross_app_dependencies": {
      "$ref": "#/$defs/range"
    },
    "max_independent_component_ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "required_delayed_reuse": {
      "type": "boolean"
    },
    "max_irreversible_actions": {
      "type": "integer",
      "minimum": 0
    },
    "min_verifier_coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "failure_reweighting": {
      "type": "object"
    },
    "type_system": {
      "type": "object"
    },
    "carry_threshold": {
      "type": "integer",
      "minimum": 1
    },
    "allowed_irreversible_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reversibility_sampling": {
      "type": "object"
    },
    "depth_grid": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "ontology_config": {
      "type": "string",
      "minLength": 1
    },
    "failure_taxonomy_config": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "range": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    }
  },
  "$comment": "synthesis-config/0.2 adds the optional v0.2 keys (carry_threshold, allowed_irreversible_actions, reversibility_sampling, depth_grid, ontology_config, failure_taxonomy_config); 0.1 files stay valid."
}
