{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://derail-benchmark.org/schemas/annotation.schema.json",
  "title": "DERAIL Human Failure Annotation v0.2",
  "$comment": "每名 annotator 的原始标签不可覆盖；VLM proposal 与 adjudication 使用独立文件。",
  "type": "object",
  "properties": {
    "annotation_id": {"type": "string", "minLength": 1},
    "trajectory_id": {"type": "string", "minLength": 1},
    "source_trajectory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "annotator_id": {"type": "string", "minLength": 1},
    "annotator_role": {"const": "human"},
    "root_cause_action_index": {"type": "integer", "minimum": 0},
    "error_horizon_actions": {"type": ["integer", "null"], "minimum": 0},
    "identifiable_at_action_index": {"type": ["integer", "null"], "minimum": 0},
    "error_types": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "reversibility": {"enum": ["reversible", "irreversible"]},
    "rationale": {"type": "string", "minLength": 1},
    "taxonomy_version": {"type": "string", "minLength": 1},
    "schema_version": {"const": "0.2.0"}
  },
  "required": [
    "annotation_id", "trajectory_id", "source_trajectory_sha256", "annotator_id",
    "annotator_role", "root_cause_action_index", "error_horizon_actions",
    "identifiable_at_action_index", "error_types", "reversibility", "rationale",
    "taxonomy_version", "schema_version"
  ],
  "additionalProperties": false
}
