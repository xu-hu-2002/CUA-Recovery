{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recovery.local/schemas/grounded_task_module.schema.json",
  "title": "RECOVERY grounded task module",
  "type": "object",
  "required": [
    "schema_version", "module_id", "source_task_id", "source_split",
    "environment_id", "snapshot_id", "world_schema_version",
    "world_subgraph_id", "fragment", "interface", "provenance"
  ],
  "properties": {
    "schema_version": {"const": "grounded-task-module/0.1"},
    "module_id": {"type": "string", "minLength": 1},
    "source_task_id": {"type": "string", "minLength": 1},
    "source_split": {
      "enum": ["source-development", "source-pilot", "source-holdout"]
    },
    "environment_id": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "world_schema_version": {"type": "string", "minLength": 1},
    "world_subgraph_id": {"type": "string", "minLength": 1},
    "instruction": {"type": "string"},
    "materializable_environments": {
      "type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true
    },
    "fragment": {"$ref": "https://recovery.local/schemas/task_fragment.schema.json"},
    "interface": {"$ref": "https://recovery.local/schemas/grounded_task_module.schema.json#/$defs/interface"},
    "provenance": {
      "type": "object",
      "required": ["source_uri", "source_sha256", "review_status"],
      "properties": {
        "source_uri": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "review_status": {"enum": ["needs_review", "human_verified"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "public_port": {
      "type": "object",
      "required": ["node_id", "port_id", "type", "grounding"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "port_id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "grounding": {"type": "string", "minLength": 1},
        "cardinality": {"enum": ["one", "optional", "many"]},
        "constraints": {"type": "object"},
        "required": {"type": "boolean"},
        "dependency_kind": {
          "enum": ["data_dependency", "state_dependency", "control_dependency"]
        }
      },
      "additionalProperties": true
    },
    "effect": {
      "type": "object",
      "required": ["effect_type", "target_id", "irreversible"],
      "properties": {
        "effect_type": {"enum": ["create", "modify", "delete", "send", "submit", "pay"]},
        "target_id": {"type": "string", "minLength": 1},
        "irreversible": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "interface": {
      "type": "object",
      "required": ["produces", "accepts", "identity_scope", "time_scope", "reads", "side_effects"],
      "properties": {
        "produces": {
          "type": "array", "minItems": 1, "items": {"$ref": "https://recovery.local/schemas/grounded_task_module.schema.json#/$defs/public_port"}
        },
        "accepts": {"type": "array", "items": {"$ref": "https://recovery.local/schemas/grounded_task_module.schema.json#/$defs/public_port"}},
        "identity_scope": {
          "type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true
        },
        "time_scope": {
          "type": "object",
          "properties": {"timezone": {"type": "string", "minLength": 1}},
          "additionalProperties": true
        },
        "reads": {
          "type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true
        },
        "side_effects": {"type": "array", "items": {"$ref": "https://recovery.local/schemas/grounded_task_module.schema.json#/$defs/effect"}}
      },
      "additionalProperties": true
    }
  }
}
