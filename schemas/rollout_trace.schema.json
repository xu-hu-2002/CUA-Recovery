{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recovery.local/schemas/rollout_trace.schema.json",
  "title": "RECOVERY rollout trace (rollout-trace/1.0)",
  "$comment": "Execution doc v1.2 sections 4.4 / 8.1 / 13: per step the action, its parameters (Params_t), screenshot and a11y hashes, database changes (Delta_t, changelog rows attributed by action_index), observation events and rendered pages (Pages_t). Pages_t of step t covers requests from the last render before action t up to action t+1.",
  "type": "object",
  "required": [
    "schema_version",
    "rollout_id",
    "task_id",
    "world_id",
    "agent",
    "seed",
    "sampling_round",
    "step_budget",
    "steps",
    "outcome",
    "modality"
  ],
  "properties": {
    "schema_version": {
      "const": "rollout-trace/1.0"
    },
    "rollout_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "world_id": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer"
    },
    "sampling_round": {
      "type": "integer",
      "minimum": 1
    },
    "step_budget": {
      "type": "integer",
      "minimum": 1
    },
    "image_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action_index",
          "action",
          "params",
          "screenshot_sha256",
          "a11y_sha256",
          "delta",
          "observations",
          "pages"
        ],
        "properties": {
          "action_index": {
            "type": "integer",
            "minimum": 0
          },
          "action": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "raw": {}
            },
            "additionalProperties": true
          },
          "params": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "value"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {},
                "target_a11y_label": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "modality": {
            "enum": [
              "gui",
              "api",
              "cli"
            ]
          },
          "thought": {
            "type": [
              "string",
              "null"
            ]
          },
          "screenshot_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "a11y_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "a11y_text_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "delta": {
            "type": "array",
            "items": {
              "$ref": "https://recovery.local/schemas/changelog_row.schema.json"
            }
          },
          "observations": {
            "type": "array",
            "items": {
              "$ref": "https://recovery.local/schemas/observation_event.schema.json"
            }
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "app",
                "route"
              ],
              "properties": {
                "app": {
                  "type": "string",
                  "minLength": 1
                },
                "route": {
                  "type": "string",
                  "minLength": 1
                },
                "rendered_fields": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "table",
                      "column"
                    ],
                    "properties": {
                      "table": {
                        "type": "string",
                        "minLength": 1
                      },
                      "column": {
                        "type": "string",
                        "minLength": 1
                      },
                      "entity": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "value": {}
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "filesystem_delta": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "op"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "op": {
                  "enum": [
                    "created",
                    "modified",
                    "deleted"
                  ]
                },
                "sha256_before": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9a-f]{64}$"
                },
                "sha256_after": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "outcome": {
      "type": "object",
      "required": [
        "final_verifier",
        "declared_complete",
        "declared_infeasible",
        "budget_exhausted"
      ],
      "properties": {
        "final_verifier": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "verifier_kind": {
          "enum": [
            "state",
            "rubric",
            null
          ]
        },
        "declared_complete": {
          "type": "boolean"
        },
        "declared_infeasible": {
          "type": "boolean"
        },
        "budget_exhausted": {
          "type": "boolean"
        },
        "extra_side_effects": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "steps_taken": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "modality": {
      "type": "object",
      "required": [
        "primary",
        "counts"
      ],
      "properties": {
        "primary": {
          "enum": [
            "gui",
            "cli",
            "mixed"
          ]
        },
        "counts": {
          "type": "object",
          "required": [],
          "properties": {
            "gui": {
              "type": "integer",
              "minimum": 0
            },
            "cli": {
              "type": "integer",
              "minimum": 0
            },
            "editor": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [],
      "properties": {},
      "additionalProperties": true
    },
    "changelog_start_seq": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "instruction": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
