{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recovery.local/schemas/prefix_repair.schema.json",
  "title": "RECOVERY automatic prefix repair (prefix-repair/1.0)",
  "$comment": "Execution doc v1.2 section 10.1: state-neutral segments removed before the root cause (net database change empty and the page after equals the page before). Non-neutral unrelated errors make the prefix PREFIX_UNREPAIRABLE; no human repair.",
  "type": "object",
  "required": [
    "schema_version",
    "rollout_id",
    "task_id",
    "root_cause_action_index",
    "removed_segments",
    "non_neutral_segments",
    "repaired_prefix_action_indices",
    "status",
    "repair_version"
  ],
  "properties": {
    "schema_version": {
      "const": "prefix-repair/1.0"
    },
    "rollout_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "root_cause_action_index": {
      "type": "integer",
      "minimum": 0
    },
    "removed_segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "start_action_index",
          "end_action_index",
          "net_delta_empty",
          "page_before",
          "page_after"
        ],
        "properties": {
          "start_action_index": {
            "type": "integer",
            "minimum": 0
          },
          "end_action_index": {
            "type": "integer",
            "minimum": 0
          },
          "net_delta_empty": {
            "type": "boolean"
          },
          "page_before": {
            "type": [
              "string",
              "null"
            ]
          },
          "page_after": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "non_neutral_segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "start_action_index",
          "end_action_index",
          "net_delta_empty",
          "page_before",
          "page_after"
        ],
        "properties": {
          "start_action_index": {
            "type": "integer",
            "minimum": 0
          },
          "end_action_index": {
            "type": "integer",
            "minimum": 0
          },
          "net_delta_empty": {
            "type": "boolean"
          },
          "page_before": {
            "type": [
              "string",
              "null"
            ]
          },
          "page_after": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "repaired_prefix_action_indices": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "repaired",
        "unchanged",
        "PREFIX_UNREPAIRABLE",
        "NON_NEUTRAL_PRE_ROOT_SEGMENT"
      ]
    },
    "repair_version": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "required": [],
      "properties": {},
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
