{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://derail.local/schemas/failure_analysis.schema.json",
  "title": "DERAIL automatic failure analysis (failure-analysis/1.0)",
  "$comment": "Execution doc v1.2 sections 9.2-9.5 / 13: outputs of the state, parameter and omission detectors, the chosen root cause, type (paper_type + group), earliest identifiable point, both horizons, censoring, analysis_path and evidence references. residual_code is ROOT_CAUSE_RESIDUAL when no detector fired or the type rule is below the residual threshold.",
  "type": "object",
  "required": [
    "schema_version",
    "rollout_id",
    "task_id",
    "agent",
    "detectors",
    "root_cause_action_index",
    "root_cause_detector",
    "paper_type",
    "paper_category",
    "group",
    "type_confidence",
    "earliest_identifiable_action_index",
    "action_horizon",
    "semantic_horizon",
    "horizon_censored",
    "analysis_path",
    "residual_code",
    "multi_root_cause",
    "analysis_version"
  ],
  "properties": {
    "schema_version": {
      "const": "failure-analysis/1.0"
    },
    "rollout_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "detectors": {
      "type": "object",
      "required": [
        "state",
        "parameter",
        "omission"
      ],
      "properties": {
        "state": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "action_index",
              "evidence",
              "confidence"
            ],
            "properties": {
              "action_index": {
                "type": "integer",
                "minimum": 0
              },
              "node_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence_pattern": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "kind",
                    "ref"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "changelog",
                        "param",
                        "page",
                        "observation",
                        "gold",
                        "screenshot"
                      ]
                    },
                    "ref": {},
                    "detail": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "parameter": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "action_index",
              "evidence",
              "confidence"
            ],
            "properties": {
              "action_index": {
                "type": "integer",
                "minimum": 0
              },
              "node_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence_pattern": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "kind",
                    "ref"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "changelog",
                        "param",
                        "page",
                        "observation",
                        "gold",
                        "screenshot"
                      ]
                    },
                    "ref": {},
                    "detail": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "omission": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "action_index",
              "evidence",
              "confidence"
            ],
            "properties": {
              "action_index": {
                "type": "integer",
                "minimum": 0
              },
              "node_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence_pattern": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "kind",
                    "ref"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "changelog",
                        "param",
                        "page",
                        "observation",
                        "gold",
                        "screenshot"
                      ]
                    },
                    "ref": {},
                    "detail": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "root_cause_action_index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "root_cause_node_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "root_cause_detector": {
      "enum": [
        "state",
        "parameter",
        "omission",
        "residual_vlm",
        "human",
        null
      ]
    },
    "paper_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "paper_category": {
      "enum": [
        "planning",
        "perception",
        "execution",
        "termination",
        null
      ]
    },
    "group": {
      "enum": [
        "local",
        "long_horizon",
        "termination",
        null
      ]
    },
    "type_confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "type_alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "paper_type",
          "confidence"
        ],
        "properties": {
          "paper_type": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "cross_type_labels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "earliest_identifiable_action_index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "earliest_identifiable_node_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "earliest_identifiable_source": {
      "enum": [
        "gui",
        "api",
        "cli",
        null
      ]
    },
    "action_horizon": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "semantic_horizon": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "horizon_censored": {
      "type": "boolean"
    },
    "analysis_path": {
      "enum": [
        "auto",
        "vlm_confirmed",
        "human_confirmed"
      ]
    },
    "residual_code": {
      "enum": [
        "ROOT_CAUSE_RESIDUAL",
        "MULTI_ROOT_CAUSE",
        null
      ]
    },
    "multi_root_cause": {
      "type": "boolean"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "analysis_version": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "required": [],
      "properties": {},
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
