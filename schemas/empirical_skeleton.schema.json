{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recovery.local/schemas/empirical_skeleton.schema.json",
  "title": "RECOVERY empirical or derived composition skeleton",
  "type": "object",
  "required": [
    "schema_version", "skeleton_id", "kind", "motif_family",
    "source_task_ids", "support_task_count", "empirical_probability",
    "anchor_ops", "composition_rules", "review_status"
  ],
  "properties": {
    "schema_version": {"const": "skeleton/0.1"},
    "skeleton_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["observed", "derived"]},
    "motif_family": {"type": "string", "minLength": 1},
    "source_task_ids": {
      "type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true
    },
    "support_task_count": {"type": "integer", "minimum": 1},
    "empirical_probability": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "complexity_prior": {"type": "number", "exclusiveMinimum": 0},
    "source_module_ids": {
      "type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true
    },
    "canonical_signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_graph": {"type": "object"},
    "anchor_ops": {
      "type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true
    },
    "composition_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "rule_id", "producer_op", "consumer_op", "value_type",
          "support_task_count", "approved", "probability"
        ],
        "properties": {
          "rule_id": {"type": "string", "minLength": 1},
          "producer_op": {"type": "string", "minLength": 1},
          "consumer_op": {"type": "string", "minLength": 1},
          "value_type": {"type": "string", "minLength": 1},
          "support_task_count": {"type": "integer", "minimum": 0},
          "approved": {"type": "boolean"},
          "probability": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
        },
        "additionalProperties": true
      }
    },
    "review_status": {"enum": ["needs_review", "human_approved", "human_rejected"]}
  },
  "additionalProperties": false
}
