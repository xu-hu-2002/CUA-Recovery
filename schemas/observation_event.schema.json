{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://derail.local/schemas/observation_event.schema.json",
  "title": "DERAIL observation event (observation-event/1.0)",
  "$comment": "Execution doc v1.2 section 4.2b: the union of the three observation sources (a11y visible text, API response, command output) flattened to facts. Fact-level detectors read only this record and do not distinguish the source.",
  "type": "object",
  "required": [
    "schema_version",
    "action_index",
    "source",
    "facts"
  ],
  "properties": {
    "schema_version": {
      "const": "observation-event/1.0"
    },
    "rollout_id": {
      "type": "string"
    },
    "action_index": {
      "type": "integer",
      "minimum": 0
    },
    "source": {
      "enum": [
        "gui",
        "api",
        "cli"
      ]
    },
    "ts": {
      "type": [
        "number",
        "string",
        "null"
      ]
    },
    "app": {
      "type": "string"
    },
    "route": {
      "type": [
        "string",
        "null"
      ]
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "https://derail.local/schemas/observation_event.schema.json#/$defs/fact"
      }
    },
    "raw_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "fact": {
      "type": "object",
      "required": [
        "table",
        "column",
        "entity",
        "value"
      ],
      "properties": {
        "table": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+\\.[A-Za-z0-9_]+$"
        },
        "column": {
          "type": "string",
          "minLength": 1
        },
        "entity": {
          "type": "string",
          "minLength": 1
        },
        "value": {}
      },
      "additionalProperties": false
    }
  }
}
