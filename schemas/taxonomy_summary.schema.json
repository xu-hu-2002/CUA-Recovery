{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recovery-benchmark.org/schemas/taxonomy_summary.schema.json",
  "title": "RECOVERY Human Open-Coding Taxonomy Summary v0.2",
  "type": "object",
  "properties": {
    "build_id": {"type": "string", "minLength": 1},
    "taxonomy_version": {"type": "string", "minLength": 1},
    "taxonomy_mode": {"enum": ["open_coding", "frozen"]},
    "seed_labels": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "adjudicated_case_count": {"type": "integer", "minimum": 0},
    "multi_label_case_count": {"type": "integer", "minimum": 0},
    "error_type_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "outside_seed_error_type_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "reversibility_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "error_horizon_actions_by_type": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "observed_count": {"type": "integer", "minimum": 0},
          "missing_count": {"type": "integer", "minimum": 0},
          "min": {"type": ["integer", "null"], "minimum": 0},
          "median": {"type": ["number", "null"], "minimum": 0},
          "max": {"type": ["integer", "null"], "minimum": 0},
          "values": {"type": "array", "items": {"type": "integer", "minimum": 0}}
        },
        "required": ["observed_count", "missing_count", "min", "median", "max", "values"],
        "additionalProperties": false
      }
    },
    "cooccurrence_counts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "error_types": {"type": "array", "prefixItems": [{"type": "string"}, {"type": "string"}], "items": false},
          "count": {"type": "integer", "minimum": 1}
        },
        "required": ["error_types", "count"],
        "additionalProperties": false
      }
    },
    "input_adjudications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "adjudication_id": {"type": "string", "minLength": 1},
          "uri": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "required": ["case_id", "adjudication_id", "uri", "sha256"],
        "additionalProperties": false
      }
    },
    "input_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "interpretation_policy": {"type": "string", "minLength": 1}
  },
  "required": [
    "build_id", "taxonomy_version", "taxonomy_mode", "seed_labels",
    "adjudicated_case_count", "multi_label_case_count", "error_type_counts",
    "outside_seed_error_type_counts", "reversibility_counts",
    "error_horizon_actions_by_type", "cooccurrence_counts", "input_adjudications",
    "input_set_sha256", "interpretation_policy"
  ],
  "additionalProperties": false
}
