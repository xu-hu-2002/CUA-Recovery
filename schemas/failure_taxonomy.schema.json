{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://derail.local/schemas/failure_taxonomy.schema.json",
  "title": "DERAIL failure taxonomy mapping (failure-taxonomy/0.1)",
  "type": "object",
  "required": [
    "schema_version", "taxonomy_version", "paper_categories", "category_to_group",
    "paper_type_to_subgroup", "primary_selection"
  ],
  "properties": {
    "schema_version": {"const": "failure-taxonomy/0.1"},
    "taxonomy_version": {"type": "string", "minLength": 1},
    "paper_categories": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
    },
    "category_to_group": {
      "type": "object",
      "additionalProperties": {"enum": ["local", "long_horizon", "termination"]}
    },
    "paper_type_to_subgroup": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "retired_labels": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "renamed_labels": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "primary_selection": {
      "type": "object",
      "required": ["category_priority"],
      "properties": {"category_priority": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}},
      "additionalProperties": false
    },
    "cross_category_labels": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "additionalProperties": false
}
