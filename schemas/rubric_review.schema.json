{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recovery-benchmark.org/schemas/rubric_review.schema.json",
  "title": "RECOVERY Human Rubric Review v0.1",
  "$comment": "一名 reviewer 对某条 trajectory 全部 rubric 的独立复核；原始判定不可覆盖，裁决使用独立文件。",
  "type": "object",
  "properties": {
    "review_id": {"type": "string", "minLength": 1},
    "trajectory_id": {"type": "string", "minLength": 1},
    "source_trajectory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rubric_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewer_id": {"type": "string", "minLength": 1},
    "reviewer_role": {"const": "human"},
    "judgments": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "https://recovery-benchmark.org/schemas/rubric_review.schema.json#/$defs/judgment"}
    },
    "schema_version": {"const": "0.1.0"}
  },
  "required": [
    "review_id", "trajectory_id", "source_trajectory_sha256", "rubric_bundle_sha256",
    "reviewer_id", "reviewer_role", "judgments", "schema_version"
  ],
  "additionalProperties": false,
  "$defs": {
    "judgment": {
      "type": "object",
      "properties": {
        "rubric_id": {"type": "string", "minLength": 1},
        "verdict": {"enum": ["success", "failure"]},
        "rationale": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1
        }
      },
      "required": ["rubric_id", "verdict", "rationale", "evidence_refs"],
      "additionalProperties": false
    }
  }
}
