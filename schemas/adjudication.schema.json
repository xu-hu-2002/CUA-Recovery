{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://derail-benchmark.org/schemas/adjudication.schema.json",
  "title": "DERAIL Human Adjudication v0.2",
  "type": "object",
  "properties": {
    "adjudication_id": {"type": "string", "minLength": 1},
    "trajectory_id": {"type": "string", "minLength": 1},
    "input_annotation_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 2, "uniqueItems": true},
    "adjudicator_id": {"type": "string", "minLength": 1},
    "root_cause_action_index": {"type": "integer", "minimum": 0},
    "error_horizon_actions": {"type": ["integer", "null"], "minimum": 0},
    "identifiable_at_action_index": {"type": ["integer", "null"], "minimum": 0},
    "error_types": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "reversibility": {"enum": ["reversible", "irreversible"]},
    "disagreement_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "resolution_rationale": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "taxonomy_version": {"type": "string", "minLength": 1},
    "schema_version": {"const": "0.2.0"}
  },
  "required": [
    "adjudication_id", "trajectory_id", "input_annotation_ids", "adjudicator_id",
    "root_cause_action_index", "error_horizon_actions", "identifiable_at_action_index",
    "error_types", "reversibility", "disagreement_fields", "resolution_rationale",
    "evidence_refs", "taxonomy_version", "schema_version"
  ],
  "additionalProperties": false
}
